pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Test') {
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn -B test'
                    } else {
                        bat 'mvn -B test'
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build image') {
            steps {
                script {
                    sh 'docker build -f Dockerfile -t chouroukchaker/auth-app-backend:$BUILD_NUMBER -t chouroukchaker/auth-app-backend:latest .'
                }
            }
        }

        stage('Push image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKERHUB_USERNAME',
                    passwordVariable: 'DOCKERHUB_PASSWORD'
                )]) {
                    sh '''set +x
DOCKER_CONFIG="$(mktemp -d)"
export DOCKER_CONFIG
trap 'rm -rf "$DOCKER_CONFIG"' EXIT
test "$DOCKERHUB_USERNAME" = "chouroukchaker"
printf '%s' "$DOCKERHUB_PASSWORD" | docker login --username "$DOCKERHUB_USERNAME" --password-stdin
docker push chouroukchaker/auth-app-backend:$BUILD_NUMBER
docker push chouroukchaker/auth-app-backend:latest'''
                }
            }
        }

        stage('Deploy backend') {
            steps {
                sh '''IMAGE_TAG="$BUILD_NUMBER" docker compose config --quiet
IMAGE_TAG="$BUILD_NUMBER" docker compose pull backend
IMAGE_TAG="$BUILD_NUMBER" docker compose up -d --no-build --wait postgres backend'''
            }
        }
    }
}